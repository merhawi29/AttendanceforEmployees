generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  LUNCH_MISSING
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String
  employeeId    String         @unique @map("employee_id")
  department    String?
  role          Role           @default(EMPLOYEE)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  attendances    Attendance[]
  refreshTokens  RefreshToken[]
  employeeDevices EmployeeDevice[]

  resetToken    String?        @map("reset_token")
  resetExpire   DateTime?      @map("reset_expire")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AllowedIp {
  id          String   @id @default(cuid())
  ipAddress   String   @unique @map("ip_address")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("allowed_ips")
}

model Attendance {
  id            String            @id @default(cuid())
  userId        String            @map("user_id")
  date          DateTime          @db.Date
  ethiopianDate String            @map("ethiopian_date") @db.VarChar(10)
  morningIn     DateTime?         @map("morning_in")
  lunchOut      DateTime?         @map("lunch_out")
  lunchReturn   DateTime?         @map("lunch_return")
  finalOut      DateTime?         @map("final_out")
  status        AttendanceStatus?
  ipAddress     String?           @map("ip_address")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([ethiopianDate])
  @@index([ipAddress, date])
  @@map("attendances")
}

model EmployeeDevice {
  id              String   @id @default(cuid())
  employeeId      String   @map("employee_id")
  deviceId        String   @unique @map("device_id")
  deviceName      String?  @map("device_name")
  browser         String?
  operatingSystem String?  @map("operating_system")
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  platform        String?
  maxTouchPoints  Int?      @map("max_touch_points")
  screenWidth     Int?      @map("screen_width")
  screenHeight    Int?      @map("screen_height")
  isMobile        Boolean?  @map("is_mobile")
  fingerprint     String?   @db.Text
  isApproved      Boolean  @default(false) @map("is_approved")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  lastUsedAt      DateTime? @map("last_used_at")
  user            User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([deviceId])
  @@map("employee_devices")
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  @@map("system_settings")
}
