generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String               @id @default(cuid())
  email                       String               @unique
  password                    String
  name                        String
  employeeId                  String               @unique @map("employee_id")
  department                  String?
  role                        Role                 @default(EMPLOYEE)
  isActive                    Boolean              @default(true) @map("is_active")
  createdAt                   DateTime             @default(now()) @map("created_at")
  updatedAt                   DateTime             @updatedAt @map("updated_at")
  resetExpire                 DateTime?            @map("reset_expire")
  resetToken                  String?              @map("reset_token")
  departmentId                String?              @map("department_id")
  employmentType              String?              @default("FULL_TIME") @map("employment_type") @db.VarChar(50)
  hireDate                    DateTime?            @map("hire_date")
  phone                       String?              @db.VarChar(30)
  positionId                  String?              @map("position_id")
  salary                      Decimal?             @db.Decimal(12, 2)
  address                     String?              @db.Text
  avatarUrl                   String?              @map("avatar_url") @db.VarChar(255)
  dateOfBirth                 DateTime?            @map("date_of_birth") @db.Date
  employmentStatus            EmploymentStatus     @default(ACTIVE) @map("employment_status")
  firstName                   String?              @map("first_name") @db.VarChar(50)
  gender                      Gender?
  lastName                    String?              @map("last_name") @db.VarChar(50)
  managerId                   String?              @map("manager_id")
  middleName                  String?              @map("middle_name") @db.VarChar(50)
  conductedAssetAssignments   AssetAssignment[]    @relation("AssignerAssetAssignments")
  assetAssignments            AssetAssignment[]    @relation("EmployeeAssetAssignments")
  assignedAssets              Asset[]              @relation("UserAssignedAssets")
  attendances                 Attendance[]
  headedDepartment            Department?          @relation("DepartmentHead")
  documents                   Document[]           @relation("UserDocuments")
  employeeDevices             EmployeeDevice[]
  conductedInterviews         Interview[]          @relation("InterviewerConducted")
  leaveBalances               LeaveBalance[]
  approvedLeaveRequests       LeaveRequest[]       @relation("AdminLeaveRequests")
  managedLeaveRequests        LeaveRequest[]       @relation("ManagerLeaveRequests")
  leaveRequests               LeaveRequest[]       @relation("EmployeeLeaveRequests")
  notifications               Notification[]       @relation("UserNotifications")
  approvedOvertimeRequests    OvertimeRequest[]    @relation("AdminOvertimeRequests")
  managedOvertimeRequests     OvertimeRequest[]    @relation("ManagerOvertimeRequests")
  overtimeRequests            OvertimeRequest[]    @relation("EmployeeOvertimeRequests")
  payrollRecords              PayrollRecord[]
  performanceGoals            PerformanceGoal[]    @relation("EmployeePerformanceGoals")
  performanceReviews          PerformanceReview[]  @relation("EmployeePerformanceReviews")
  givenPerformanceReviews     PerformanceReview[]  @relation("ReviewerPerformanceReviews")
  refreshTokens               RefreshToken[]
  salaryStructure             SalaryStructure?
  approvedTrainingEnrollments TrainingEnrollment[] @relation("AdminApprovedTrainingEnrollments")
  trainingEnrollments         TrainingEnrollment[] @relation("EmployeeTrainingEnrollments")
  departmentRef               Department?          @relation("DepartmentMembers", fields: [departmentId], references: [id])
  manager                     User?                @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports               User[]               @relation("EmployeeManager")
  position                    Position?            @relation("PositionEmployees", fields: [positionId], references: [id])

  @@index([departmentId])
  @@index([positionId])
  @@index([managerId])
  @@map("users")
}

model Department {
  id                 String       @id @default(cuid())
  code               String       @unique @db.VarChar(20)
  name               String       @unique @db.VarChar(100)
  description        String?      @db.Text
  managerId          String?      @unique @map("manager_id")
  parentDepartmentId String?      @map("parent_department_id")
  costCenterCode     String?      @map("cost_center_code") @db.VarChar(50)
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  head               User?        @relation("DepartmentHead", fields: [managerId], references: [id])
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  subDepartments     Department[] @relation("DepartmentHierarchy")
  documents          Document[]   @relation("DepartmentDocuments")
  positions          Position[]   @relation("DepartmentPositions")
  members            User[]       @relation("DepartmentMembers")

  @@index([parentDepartmentId])
  @@map("departments")
}

model Position {
  id           String     @id @default(cuid())
  code         String     @unique @db.VarChar(20)
  title        String     @db.VarChar(100)
  description  String?    @db.Text
  departmentId String     @map("department_id")
  jobLevel     String?    @map("job_level") @db.VarChar(50)
  minSalary    Decimal?   @map("min_salary") @db.Decimal(12, 2)
  maxSalary    Decimal?   @map("max_salary") @db.Decimal(12, 2)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  department   Department @relation("DepartmentPositions", fields: [departmentId], references: [id], onDelete: Cascade)
  employees    User[]     @relation("PositionEmployees")

  @@index([departmentId])
  @@map("positions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AllowedIp {
  id          String   @id @default(cuid())
  ipAddress   String   @unique @map("ip_address")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("allowed_ips")
}

model Attendance {
  id            String            @id @default(cuid())
  userId        String            @map("user_id")
  date          DateTime          @db.Date
  ethiopianDate String            @map("ethiopian_date") @db.VarChar(10)
  morningIn     DateTime?         @map("morning_in")
  lunchOut      DateTime?         @map("lunch_out")
  lunchReturn   DateTime?         @map("lunch_return")
  finalOut      DateTime?         @map("final_out")
  status        AttendanceStatus?
  ipAddress     String?           @map("ip_address")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([ethiopianDate])
  @@index([ipAddress, date])
  @@map("attendances")
}

model EmployeeDevice {
  id              String    @id @default(cuid())
  employeeId      String    @map("employee_id")
  deviceId        String    @unique @map("device_id")
  deviceName      String?   @map("device_name")
  browser         String?
  operatingSystem String?   @map("operating_system")
  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent")
  isApproved      Boolean   @default(false) @map("is_approved")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  lastUsedAt      DateTime? @map("last_used_at")
  fingerprint     String?   @db.Text
  isMobile        Boolean?  @map("is_mobile")
  maxTouchPoints  Int?      @map("max_touch_points")
  platform        String?
  screenHeight    Int?      @map("screen_height")
  screenWidth     Int?      @map("screen_width")
  user            User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([deviceId])
  @@map("employee_devices")
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  @@map("system_settings")
}

model LeaveType {
  id                 String         @id @default(cuid())
  code               String         @unique @db.VarChar(20)
  name               String         @db.VarChar(100)
  description        String?        @db.Text
  defaultDaysPerYear Decimal        @default(0.00) @map("default_days_per_year") @db.Decimal(5, 2)
  isPaid             Boolean        @default(true) @map("is_paid")
  requiresApproval   Boolean        @default(true) @map("requires_approval")
  isActive           Boolean        @default(true) @map("is_active")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  balances           LeaveBalance[]
  leaveRequests      LeaveRequest[]

  @@map("leave_types")
}

model LeaveBalance {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  leaveTypeId   String    @map("leave_type_id")
  year          Int
  allocatedDays Decimal   @default(0.00) @map("allocated_days") @db.Decimal(5, 2)
  usedDays      Decimal   @default(0.00) @map("used_days") @db.Decimal(5, 2)
  pendingDays   Decimal   @default(0.00) @map("pending_days") @db.Decimal(5, 2)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, leaveTypeId, year])
  @@index([userId])
  @@index([leaveTypeId])
  @@map("leave_balances")
}

model LeaveRequest {
  id             String             @id @default(cuid())
  userId         String             @map("user_id")
  leaveTypeId    String             @map("leave_type_id")
  startDate      DateTime           @map("start_date") @db.Date
  endDate        DateTime           @map("end_date") @db.Date
  totalDays      Decimal            @map("total_days") @db.Decimal(5, 2)
  reason         String             @db.Text
  status         LeaveRequestStatus @default(PENDING)
  managerId      String?            @map("manager_id")
  managerComment String?            @map("manager_comment") @db.Text
  approvedById   String?            @map("approved_by_id")
  adminComment   String?            @map("admin_comment") @db.Text
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  approvedBy     User?              @relation("AdminLeaveRequests", fields: [approvedById], references: [id])
  leaveType      LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  manager        User?              @relation("ManagerLeaveRequests", fields: [managerId], references: [id])
  user           User               @relation("EmployeeLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([leaveTypeId])
  @@index([managerId])
  @@index([approvedById])
  @@index([status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

model OvertimeRequest {
  id             String           @id @default(cuid())
  userId         String           @map("user_id")
  date           DateTime         @db.Date
  startTime      String           @map("start_time") @db.VarChar(10)
  endTime        String           @map("end_time") @db.VarChar(10)
  totalHours     Decimal          @map("total_hours") @db.Decimal(5, 2)
  category       OvertimeCategory @default(NORMAL_DAY)
  multiplierRate Decimal          @default(1.50) @map("multiplier_rate") @db.Decimal(3, 2)
  reason         String           @db.Text
  status         OvertimeStatus   @default(PENDING)
  managerId      String?          @map("manager_id")
  managerComment String?          @map("manager_comment") @db.Text
  approvedById   String?          @map("approved_by_id")
  adminComment   String?          @map("admin_comment") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  approvedBy     User?            @relation("AdminOvertimeRequests", fields: [approvedById], references: [id])
  manager        User?            @relation("ManagerOvertimeRequests", fields: [managerId], references: [id])
  user           User             @relation("EmployeeOvertimeRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([managerId])
  @@index([approvedById])
  @@index([status])
  @@index([date])
  @@map("overtime_requests")
}

model SalaryStructure {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")
  basicSalary        Decimal  @default(0.00) @map("basic_salary") @db.Decimal(12, 2)
  housingAllowance   Decimal  @default(0.00) @map("housing_allowance") @db.Decimal(12, 2)
  transportAllowance Decimal  @default(0.00) @map("transport_allowance") @db.Decimal(12, 2)
  otherAllowance     Decimal  @default(0.00) @map("other_allowance") @db.Decimal(12, 2)
  bonus              Decimal  @default(0.00) @db.Decimal(12, 2)
  deduction          Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("salary_structures")
}

model PayrollRecord {
  id                 String        @id @default(cuid())
  userId             String        @map("user_id")
  month              Int
  year               Int
  basicSalary        Decimal       @default(0.00) @map("basic_salary") @db.Decimal(12, 2)
  housingAllowance   Decimal       @default(0.00) @map("housing_allowance") @db.Decimal(12, 2)
  transportAllowance Decimal       @default(0.00) @map("transport_allowance") @db.Decimal(12, 2)
  otherAllowance     Decimal       @default(0.00) @map("other_allowance") @db.Decimal(12, 2)
  bonus              Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAllowances    Decimal       @default(0.00) @map("total_allowances") @db.Decimal(12, 2)
  deduction          Decimal       @default(0.00) @db.Decimal(12, 2)
  totalDeductions    Decimal       @default(0.00) @map("total_deductions") @db.Decimal(12, 2)
  grossSalary        Decimal       @default(0.00) @map("gross_salary") @db.Decimal(12, 2)
  netSalary          Decimal       @default(0.00) @map("net_salary") @db.Decimal(12, 2)
  status             PayrollStatus @default(DRAFT)
  remarks            String?       @db.Text
  processedAt        DateTime?     @map("processed_at")
  paidAt             DateTime?     @map("paid_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId])
  @@index([month, year])
  @@index([status])
  @@map("payroll_records")
}

model Holiday {
  id          String      @id @default(cuid())
  name        String      @db.VarChar(150)
  description String?     @db.Text
  holidayDate DateTime    @map("holiday_date") @db.Date
  holidayType HolidayType @default(PUBLIC) @map("holiday_type")
  isRecurring Boolean     @default(false) @map("is_recurring")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([holidayDate])
  @@index([holidayType])
  @@map("holidays")
}

model PerformanceReview {
  id             String            @id @default(cuid())
  employeeId     String            @map("employee_id")
  reviewerId     String            @map("reviewer_id")
  reviewDate     DateTime          @map("review_date") @db.Date
  overallScore   Float             @map("overall_score")
  rating         PerformanceRating
  strengths      String?           @db.Text
  weaknesses     String?           @db.Text
  comments       String?           @db.Text
  recommendation String?           @db.VarChar(255)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  employee       User              @relation("EmployeePerformanceReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer       User              @relation("ReviewerPerformanceReviews", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([reviewerId])
  @@index([rating])
  @@index([reviewDate])
  @@map("performance_reviews")
}

model PerformanceGoal {
  id                 String     @id @default(cuid())
  employeeId         String     @map("employee_id")
  title              String     @db.VarChar(255)
  description        String?    @db.Text
  targetDate         DateTime   @map("target_date") @db.Date
  progressPercentage Int        @default(0) @map("progress_percentage")
  status             GoalStatus @default(NOT_STARTED)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  employee           User       @relation("EmployeePerformanceGoals", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([targetDate])
  @@map("performance_goals")
}

model JobPosting {
  id             String           @id @default(cuid())
  code           String           @unique @db.VarChar(50)
  title          String           @db.VarChar(255)
  department     String?          @db.VarChar(100)
  location       String?          @db.VarChar(100)
  employmentType String           @default("FULL_TIME") @map("employment_type") @db.VarChar(50)
  description    String           @db.Text
  requirements   String?          @db.Text
  minSalary      Decimal?         @map("min_salary") @db.Decimal(12, 2)
  maxSalary      Decimal?         @map("max_salary") @db.Decimal(12, 2)
  status         JobStatus        @default(DRAFT)
  closingDate    DateTime?        @map("closing_date") @db.Date
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  applications   JobApplication[]

  @@index([status])
  @@index([department])
  @@map("job_postings")
}

model JobApplication {
  id              String            @id @default(cuid())
  jobPostingId    String            @map("job_posting_id")
  applicantName   String            @map("applicant_name") @db.VarChar(150)
  email           String            @db.VarChar(150)
  phone           String?           @db.VarChar(30)
  resumeUrl       String?           @map("resume_url") @db.VarChar(255)
  coverLetter     String?           @map("cover_letter") @db.Text
  experienceYears Float?            @map("experience_years")
  currentCompany  String?           @map("current_company") @db.VarChar(150)
  status          ApplicationStatus @default(APPLIED)
  rating          Int?              @default(0)
  notes           String?           @db.Text
  appliedDate     DateTime          @default(now()) @map("applied_date")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  interviews      Interview[]
  jobPosting      JobPosting        @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@index([jobPostingId])
  @@index([status])
  @@index([email])
  @@map("job_applications")
}

model Interview {
  id               String          @id @default(cuid())
  jobApplicationId String          @map("job_application_id")
  interviewerId    String          @map("interviewer_id")
  interviewType    InterviewType   @default(TECHNICAL) @map("interview_type")
  scheduledAt      DateTime        @map("scheduled_at")
  location         String?         @db.VarChar(255)
  status           InterviewStatus @default(SCHEDULED)
  feedback         String?         @db.Text
  score            Float?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  interviewer      User            @relation("InterviewerConducted", fields: [interviewerId], references: [id], onDelete: Cascade)
  jobApplication   JobApplication  @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  @@index([jobApplicationId])
  @@index([interviewerId])
  @@index([status])
  @@map("interviews")
}

model AssetCategory {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(50)
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  assets      Asset[]

  @@map("asset_categories")
}

model Asset {
  id             String            @id @default(cuid())
  assetTag       String            @unique @map("asset_tag") @db.VarChar(50)
  name           String            @db.VarChar(150)
  categoryId     String            @map("category_id")
  brand          String?           @db.VarChar(100)
  model          String?           @db.VarChar(100)
  serialNumber   String?           @unique @map("serial_number") @db.VarChar(100)
  purchaseDate   DateTime?         @map("purchase_date") @db.Date
  purchaseCost   Decimal?          @map("purchase_cost") @db.Decimal(12, 2)
  warrantyExpiry DateTime?         @map("warranty_expiry") @db.Date
  status         AssetStatus       @default(AVAILABLE)
  condition      AssetCondition    @default(EXCELLENT)
  assignedToId   String?           @map("assigned_to_id")
  assignedDate   DateTime?         @map("assigned_date") @db.Date
  notes          String?           @db.Text
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  assignments    AssetAssignment[]
  assignedTo     User?             @relation("UserAssignedAssets", fields: [assignedToId], references: [id])
  category       AssetCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([assignedToId])
  @@index([status])
  @@map("assets")
}

model AssetAssignment {
  id                String           @id @default(cuid())
  assetId           String           @map("asset_id")
  employeeId        String           @map("employee_id")
  assignedById      String           @map("assigned_by_id")
  assignedDate      DateTime         @default(now()) @map("assigned_date")
  returnedDate      DateTime?        @map("returned_date")
  conditionOnAssign AssetCondition   @default(EXCELLENT) @map("condition_on_assign")
  conditionOnReturn AssetCondition?  @map("condition_on_return")
  status            AssignmentStatus @default(ACTIVE)
  notes             String?          @db.Text
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  asset             Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assigner          User             @relation("AssignerAssetAssignments", fields: [assignedById], references: [id], onDelete: Cascade)
  employee          User             @relation("EmployeeAssetAssignments", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([employeeId])
  @@index([status])
  @@index([assignedById], map: "asset_assignments_assigned_by_id_fkey")
  @@map("asset_assignments")
}

model TrainingProgram {
  id           String               @id @default(cuid())
  code         String               @unique @db.VarChar(50)
  title        String               @db.VarChar(150)
  description  String               @db.Text
  category     String?              @db.VarChar(100)
  trainerName  String?              @map("trainer_name") @db.VarChar(100)
  location     String?              @db.VarChar(255)
  startDate    DateTime             @map("start_date") @db.Date
  endDate      DateTime             @map("end_date") @db.Date
  capacity     Int                  @default(20)
  status       TrainingStatus       @default(OPEN)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  materialsUrl String?              @map("materials_url") @db.Text
  enrollments  TrainingEnrollment[]

  @@index([status])
  @@index([category])
  @@map("training_programs")
}

model TrainingEnrollment {
  id                String           @id @default(cuid())
  trainingProgramId String           @map("training_program_id")
  employeeId        String           @map("employee_id")
  enrolledDate      DateTime         @default(now()) @map("enrolled_date")
  status            EnrollmentStatus @default(PENDING)
  score             Float?
  certificateUrl    String?          @map("certificate_url")
  certificateNo     String?          @map("certificate_no") @db.VarChar(100)
  issueDate         DateTime?        @map("issue_date") @db.Date
  feedback          String?          @db.Text
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  appliedAt         DateTime         @default(now()) @map("applied_at")
  approvedAt        DateTime?        @map("approved_at")
  approvedById      String?          @map("approved_by_id")
  completionDate    DateTime?        @map("completion_date")
  remarks           String?          @db.Text
  approvedBy        User?            @relation("AdminApprovedTrainingEnrollments", fields: [approvedById], references: [id])
  employee          User             @relation("EmployeeTrainingEnrollments", fields: [employeeId], references: [id], onDelete: Cascade)
  trainingProgram   TrainingProgram  @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)

  @@index([trainingProgramId])
  @@index([employeeId])
  @@index([approvedById])
  @@index([status])
  @@map("training_enrollments")
}

model DocumentCategory {
  id          String     @id @default(cuid())
  code        String     @unique @db.VarChar(50)
  name        String     @unique @db.VarChar(100)
  description String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  documents   Document[]

  @@map("document_categories")
}

model Document {
  id           String           @id @default(cuid())
  documentNo   String           @unique @map("document_no") @db.VarChar(50)
  title        String           @db.VarChar(150)
  categoryId   String           @map("category_id")
  type         DocumentType     @default(PERSONAL)
  fileUrl      String           @map("file_url") @db.Text
  fileType     String?          @map("file_type") @db.VarChar(50)
  fileSize     Int?             @map("file_size")
  ownerId      String?          @map("owner_id")
  departmentId String?          @map("department_id")
  issueDate    DateTime?        @map("issue_date") @db.Date
  expiryDate   DateTime?        @map("expiry_date") @db.Date
  status       DocumentStatus   @default(ACTIVE)
  notes        String?          @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  category     DocumentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  department   Department?      @relation("DepartmentDocuments", fields: [departmentId], references: [id])
  owner        User?            @relation("UserDocuments", fields: [ownerId], references: [id])

  @@index([categoryId])
  @@index([ownerId])
  @@index([departmentId])
  @@index([type])
  @@index([status])
  @@map("documents")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  title     String           @db.VarChar(150)
  message   String           @db.Text
  type      NotificationType @default(SYSTEM)
  link      String?          @db.VarChar(255)
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@map("notifications")
}

